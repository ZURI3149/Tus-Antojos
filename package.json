{
  "name": "tus-antojos",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build:shared": "pnpm --filter @tus-antojos/shared run build",
    "dev": "pnpm build:shared && pnpm -r --parallel --if-present run dev",
    "build": "pnpm -r --if-present run build",
    "lint": "eslint .",
    "typecheck": "pnpm build:shared && pnpm -r --if-present run typecheck",
    "test": "pnpm build:shared && pnpm -r --if-present run test",
    "test:db": "pnpm -r --workspace-concurrency=1 --if-present run test:db",
    "test:e2e": "pnpm -r --if-present run test:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:start": "node scripts/ensure-signing-key.mjs && supabase start",
    "db:start:ci": "node scripts/ensure-signing-key.mjs && supabase start -x studio,imgproxy,mailpit,postgres-meta,edge-runtime,logflare,vector,supavisor",
    "db:stop": "supabase stop",
    "db:reset": "node scripts/ensure-signing-key.mjs && supabase db reset",
    "db:types": "supabase gen types --lang typescript --schema public > packages/shared/src/db/.database.types.gen.ts && mv packages/shared/src/db/.database.types.gen.ts packages/shared/src/db/database.types.ts && prettier --write --log-level warn packages/shared/src/db/database.types.ts",
    "env:local": "node scripts/setup-local-env.mjs",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "supabase": "^3.1.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2"
  }
}
