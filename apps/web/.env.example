# Copia este archivo a .env y completa los valores.
# Todas estas variables son PÚBLICAS (van dentro del bundle del navegador).
# Nunca pongas aquí la service role key de Supabase.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_API_URL=
# Opcionales (sin DSN no se envía nada a Sentry)
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=
# Versión que se reporta a Sentry (en despliegue: el SHA del commit).
VITE_APP_VERSION=
