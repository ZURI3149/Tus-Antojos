# Copia este archivo a .env y completa los valores.
# En local, los valores de Supabase salen de `pnpm supabase status`.

NODE_ENV=
PORT=
LOG_LEVEL=
# Orígenes permitidos para CORS, separados por comas.
CORS_ORIGINS=
# Versión que se reporta en /health y Sentry (en despliegue: el SHA del commit).
APP_VERSION=

# Supabase
SUPABASE_URL=
# SECRETA: nunca la expongas al frontend ni la subas al repositorio.
SUPABASE_SERVICE_ROLE_KEY=
# Opcional. Por defecto: ${SUPABASE_URL}/auth/v1/.well-known/jwks.json
SUPABASE_JWKS_URL=
# Opcional. Solo si el proyecto aún firma los JWT con HS256 (clave compartida). SECRETA.
SUPABASE_JWT_SECRET=
# Opcional. Emisor esperado de los JWT. Por defecto: ${SUPABASE_URL}/auth/v1
SUPABASE_JWT_ISSUER=

# Sentry (opcional: sin DSN no se envía nada)
SENTRY_DSN=
SENTRY_ENVIRONMENT=
