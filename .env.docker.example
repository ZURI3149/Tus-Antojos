# Variables para levantar el proyecto con Docker Compose
# Copia este archivo a .env o .env.docker si necesitas personalizar la configuración.

# --- Puertos del Host ---
API_PORT=
WEB_PORT=

# --- Configuración de la API (NestJS) ---
NODE_ENV=production
LOG_LEVEL=info
CORS_ORIGINS=
APP_VERSION=

# Si usas Supabase local (iniciado con pnpm db:start en el host):
SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY se toma de apps/api/.env si existe, o puedes definirla aquí:
SUPABASE_SERVICE_ROLE_KEY=

# Si usas Supabase Cloud:
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=pega_aqui_service_role_key_de_supabase_cloud

# --- Configuración de la Web (React PWA) ---
# Nota: estas variables se inyectan en tiempo de construcción de la imagen web
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_API_URL=
VITE_APP_VERSION=

# --- Observabilidad (Opcional) ---
SENTRY_DSN=
SENTRY_ENVIRONMENT=
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=
